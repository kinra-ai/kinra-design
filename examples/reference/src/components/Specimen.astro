---
interface Props {
	title: string;
	contract: string;
	description: string;
}

const { title, contract, description } = Astro.props;
---

<section class="specimen">
	<header class="specimen__header">
		<div>
			<h2>{title}</h2>
			<code>{contract}</code>
		</div>
		<p>{description}</p>
	</header>
	<div class="specimen__stage">
		<slot />
	</div>
</section>

<style>
	code {
		color: var(--kin-color-text-muted);
		display: block;
		font-size: var(--kin-text-xs);
		line-height: 1.65;
		margin-top: var(--kin-space-2);
		overflow-wrap: anywhere;
	}
</style>
