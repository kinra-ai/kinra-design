{
  "name": "@kinra/web",
  "version": "0.2.0",
  "description": "Kinra's framework-light design system for web products and public surfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "assets",
    "docs",
    "registry",
    "src/styles",
    "CHANGELOG.md",
    "README.md",
    "STATUS.md",
    "TRADEMARKS.md"
  ],
  "exports": {
    ".": "./src/styles/index.css",
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./assets/*": "./assets/*",
    "./registry": "./registry/registry.json",
    "./registry/*": "./registry/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "astro dev --root examples/reference",
    "build:reference": "astro build --root examples/reference",
    "check:contract": "node scripts/check-contract.mjs",
    "check": "npm run check:contract && astro check --root examples/reference && npm run format:check",
    "verify": "npm run check && npm run build:reference",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinra-ai/kinra-design.git"
  },
  "bugs": {
    "url": "https://github.com/kinra-ai/kinra-design/issues"
  },
  "homepage": "https://github.com/kinra-ai/kinra-design#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.17.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.1.4",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
