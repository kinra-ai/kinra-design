{
  "name": "@kinra/web",
  "version": "0.7.1",
  "description": "Kinra's framework-light design system for web products and public surfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "assets",
    "docs",
    "registry",
    "src/styles",
    "src/svelte",
    "tools",
    "CHANGELOG.md",
    "README.md",
    "STATUS.md",
    "TRADEMARKS.md"
  ],
  "exports": {
    ".": "./src/styles/index.css",
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./assets/*": "./assets/*",
    "./svelte": {
      "types": "./src/svelte/index.d.ts",
      "svelte": "./src/svelte/index.js",
      "default": "./src/svelte/index.js"
    },
    "./registry": "./registry/registry.json",
    "./registry/*": "./registry/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "bin": {
    "kinra-check-spacing": "./tools/check-spacing.mjs"
  },
  "scripts": {
    "dev": "cd examples/reference && astro dev",
    "build:reference": "astro build --root examples/reference",
    "check:contract": "node scripts/check-contract.mjs",
    "check": "npm run check:contract && npm run check:spacing && npm run test:tools && npm run check:svelte && astro check --root examples/reference && npm run format:check",
    "verify": "npm run check && npm run build:reference && npm run test:browser",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:spacing": "node tools/check-spacing.mjs src/styles registry",
    "test:tools": "node --test tests/unit/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinra-ai/kinra-design.git"
  },
  "bugs": {
    "url": "https://github.com/kinra-ai/kinra-design/issues"
  },
  "homepage": "https://github.com/kinra-ai/kinra-design#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.17.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "9.1.2",
    "@playwright/test": "1.63.0",
    "astro": "7.4.12",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
